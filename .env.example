# Copy to .env and fill in. .env is gitignored.
GATEKEEPER_MODE=live                # live | replay
SKILLS_DIR=vendor/day-trader-skill  # or C:/Users/Lenovo/.claude/skills
PROJECT_ROOT=.                      # cwd for skill scripts (shared trader/)
DB_URL=sqlite:///data/gatekeeper.db
SEC_USER_AGENT=Your Name you@example.com
CORE_TICKERS=TSLA,NVDA,AMD,AAPL,MSFT,META,AMZN,GOOGL,NFLX,PLTR,COIN,SMCI,SPY,QQQ
AWAKE_IST=18:30-23:30
FULL_UNIVERSE_ORB=false             # true: the 10:15 ORB scan covers all ~5,900 stocks (~4 min)
DISABLED_JOBS=                      # worker jobs to switch off, e.g. pelosi,analyst_watchlist
WORKER_LOCK_TIMEOUT=300
NOTIFY=toast                        # none | toast | telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Phase 8 only (paper):
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Go / No-Go thresholds (Phase 5); the defaults are shown
# GATE_WINDOW_WARN_MIN=15
# GATE_DAILY_LOSS_WARN_PCT=66
# GATE_TRADES_WARN_LEFT=1
# GATE_PDT_WARN=2
# GATE_VIX_SPIKE_PCT=10
# GATE_BREADTH_WARN_PCT=10
# GATE_FORM_TRADES=5
# GATE_FORM_R_WARN=-3
# GATE_FORM_BROKEN_WARN=2
# GATE_ENTRY_STALE_BARS=1
# GATE_NEWS_HOURS=24
